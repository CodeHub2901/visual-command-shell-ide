{
  "name": "@cmd-ide/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first visual command and shell IDE",
  "author": {
    "name": "Command IDE contributors",
    "email": "CodeHub2901@users.noreply.github.com"
  },
  "homepage": "https://github.com/CodeHub2901/visual-command-shell-ide",
  "license": "Apache-2.0",
  "desktopName": "dev.commandide.desktop",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:main && pnpm build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run --exclude src/renderer/performance-budgets.test.ts",
    "test:performance": "vitest run src/renderer/performance-budgets.test.ts --disableConsoleIntercept",
    "start": "electron ."
  },
  "dependencies": {
    "@cmd-ide/contracts": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.11.2",
    "bash-language-server": "5.6.0",
    "monaco-editor": "^0.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.commandide.desktop",
    "productName": "Command IDE",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../worker/target/worker-0.1.0-all.jar",
        "to": "worker/worker-all.jar"
      },
      {
        "from": "../worker/target/runtime",
        "to": "runtime"
      },
      {
        "from": "../../build/release-metadata",
        "to": "metadata"
      }
    ],
    "linux": {
      "artifactName": "command-ide-${version}-${arch}.${ext}",
      "category": "Development",
      "executableName": "command-ide",
      "icon": "assets/packaging/icon.svg",
      "maintainer": "Command IDE contributors <CodeHub2901@users.noreply.github.com>",
      "packageName": "command-ide",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "win": {
      "icon": "assets/packaging/icon.svg"
    }
  }
}
