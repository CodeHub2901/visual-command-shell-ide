{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/catalog-search.schema.json",
  "title": "CatalogSearchResult",
  "type": "object",
  "required": ["catalogVersion", "total", "commands"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "total": { "type": "integer", "minimum": 0 },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "required": ["id", "label", "description", "required", "repeatable"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "repeatable": { "type": "boolean" }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "flags", "description", "takesValue", "valueName", "repeatable", "combinable", "conflictsWith"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "flags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1 },
        "takesValue": { "type": "boolean" },
        "valueName": { "type": ["string", "null"] },
        "repeatable": { "type": "boolean" },
        "combinable": { "type": "boolean" },
        "conflictsWith": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "manualSection": {
      "type": "object",
      "required": ["heading", "body"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "executable", "versionProbeArguments", "displayName", "summary", "category", "platforms", "distroFamilies", "arguments", "riskTags", "shortOptionPolicy", "availability", "executablePath", "compatibility", "options", "examples", "manual"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "executable": { "type": "string", "minLength": 1 },
        "versionProbeArguments": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "displayName": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["linux", "macos", "windows"] } },
        "distroFamilies": { "type": "array", "items": { "enum": ["ubuntu", "fedora", "other"] } },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/argument" } },
        "riskTags": { "type": "array", "items": { "enum": ["read-only", "filesystem-write", "network", "process-signal", "package-query", "system-change", "package-change", "privilege", "destructive"] } },
        "shortOptionPolicy": { "enum": ["never", "combine-boolean"] },
        "availability": { "enum": ["installed", "missing", "unknown"] },
        "executablePath": { "type": ["string", "null"] },
        "compatibility": {
          "type": "object",
          "required": ["status", "target", "note"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["supported", "limited", "unsupported", "unknown"] },
            "target": { "type": "string", "minLength": 1, "maxLength": 200 },
            "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "examples": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "manual": {
          "type": "object",
          "required": ["synopsis", "sections"],
          "additionalProperties": false,
          "properties": {
            "synopsis": { "type": "string", "minLength": 1 },
            "sections": { "type": "array", "items": { "$ref": "#/$defs/manualSection" } }
          }
        }
      }
    }
  }
}
