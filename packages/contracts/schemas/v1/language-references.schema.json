{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/language-references.schema.json",
  "title": "LanguageReferencesResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["references"],
  "properties": {
    "references": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["range"],
        "properties": {
          "range": { "$ref": "language-diagnostics.schema.json#/$defs/range" }
        }
      }
    }
  }
}
