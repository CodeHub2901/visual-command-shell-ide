{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/credential-store.schema.json",
  "title": "CredentialStoreParams",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "credential"],
  "properties": {
    "provider": { "const": "openai" },
    "credential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
