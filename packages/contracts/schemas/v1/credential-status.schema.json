{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/credential-status.schema.json",
  "title": "CredentialStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "configured", "storage", "backend", "reason"],
  "properties": {
    "provider": { "const": "openai" },
    "configured": { "type": "boolean" },
    "storage": { "enum": ["secure", "session", "unavailable"] },
    "backend": {
      "enum": [
        "windows-credential-manager",
        "macos-keychain",
        "linux-secret-service",
        "session-memory",
        "none"
      ]
    },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 }
  },
  "oneOf": [
    {
      "properties": {
        "storage": { "const": "secure" },
        "backend": {
          "enum": [
            "windows-credential-manager",
            "macos-keychain",
            "linux-secret-service"
          ]
        },
        "reason": { "type": "null" }
      }
    },
    {
      "properties": {
        "configured": { "const": true },
        "storage": { "const": "session" },
        "backend": { "const": "session-memory" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "properties": {
        "configured": { "const": false },
        "storage": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
