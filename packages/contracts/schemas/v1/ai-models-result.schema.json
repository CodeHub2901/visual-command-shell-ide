{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/ai-models-result.schema.json",
  "title": "AiModelsResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "models", "reason"],
  "properties": {
    "status": { "enum": ["available", "unavailable", "failed"] },
    "models": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "parameterSize", "quantization"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 500 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 500 },
          "parameterSize": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
          "quantization": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "available" },
        "reason": { "type": "null" }
      }
    },
    {
      "properties": {
        "status": { "enum": ["unavailable", "failed"] },
        "models": { "maxItems": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
