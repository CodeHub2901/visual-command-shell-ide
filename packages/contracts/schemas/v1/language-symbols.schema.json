{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/language-symbols.schema.json",
  "title": "LanguageSymbolsResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbols"],
  "properties": {
    "symbols": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "detail", "containerName", "kind", "range", "selectionRange"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 500 },
          "detail": { "type": ["string", "null"], "maxLength": 2000 },
          "containerName": { "type": ["string", "null"], "maxLength": 500 },
          "kind": { "type": "integer", "minimum": 1, "maximum": 26 },
          "range": { "$ref": "language-diagnostics.schema.json#/$defs/range" },
          "selectionRange": { "$ref": "language-diagnostics.schema.json#/$defs/range" }
        }
      }
    }
  }
}
