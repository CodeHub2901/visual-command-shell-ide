{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://command-ide.dev/schemas/v1/shellcheck-result.schema.json",
  "title": "ShellCheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "diagnostics", "reason"],
  "properties": {
    "status": { "enum": ["completed", "unavailable", "failed"] },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "language-diagnostics.schema.json#/$defs/diagnostic" }
    },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "reason": { "type": "null" } } },
      "else": {
        "properties": {
          "diagnostics": { "maxItems": 0 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
