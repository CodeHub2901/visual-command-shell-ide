{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandide.dev/schemas/v1/health-check.schema.json",
  "title": "HealthCheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "workerVersion", "javaVersion", "pid"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "workerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "javaVersion": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer", "minimum": 1 }
  }
}

